[Unit]
Description=RamFlow - foreground-first resource orchestrator
Documentation=https://github.com/homesweetlove/RamFlow_Linux
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ramflow run --config /etc/ramflow/ramflow.conf
# On stop RamFlow restores everything it changed before it exits.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
StateDirectory=ramflow

# Only what is needed:
#   CAP_SYS_NICE      lower/raise priorities
#   CAP_SYS_PTRACE    read other processes' details
#   CAP_DAC_OVERRIDE  write another user's /proc/<pid>/autogroup (lowering a whole session);
#                     without it RamFlow falls back to lowering single processes
CapabilityBoundingSet=CAP_SYS_NICE CAP_SYS_PTRACE CAP_DAC_OVERRIDE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
