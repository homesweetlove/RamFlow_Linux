[Unit]
Description=RamFlow - foreground-first resource orchestrator
Documentation=https://github.com/homesweetlove/RamFlow-Linux
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ramflow run --config /etc/ramflow/ramflow.conf
# On stop RamFlow restores everything it changed before it exits.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
StateDirectory=ramflow

# Only what is needed: lowering/raising priorities and reading other processes' details.
CapabilityBoundingSet=CAP_SYS_NICE CAP_SYS_PTRACE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0077
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
