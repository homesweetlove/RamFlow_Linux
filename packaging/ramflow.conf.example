# RamFlow 설정 파일 — /etc/ramflow/ramflow.conf
# '#' 로 시작하는 줄은 설명입니다. 같은 항목(yield, protect)은 여러 줄 쓸 수 있습니다.

# 예행연습. true 이면 무엇을 할지 로그로만 알려주고 아무것도 바꾸지 않습니다.
# 로그를 며칠 지켜본 뒤 false 로 바꾸세요. (또는 실행할 때 --apply)
dry_run = true

# 몇 밀리초마다 확인할지 (200 ~ 60000). 한가할 때는 거의 일을 하지 않습니다.
interval_ms = 2000

# ── 양보할 배경 작업 ─────────────────────────────────────────────
# 자원이 모자랄 때 우선순위를 낮춰도 되는 작업을 직접 적습니다.
# 여기에 적지 않은 프로그램은 절대 건드리지 않습니다.
# 형식 1) 실행 파일 전체 경로  : 같은 이름의 다른 프로그램과 헷갈리지 않아 가장 안전합니다.
# 형식 2) comm:이름           : 커널이 보는 프로그램 이름(15글자까지)
#yield = /usr/bin/ffmpeg
#yield = /usr/bin/make
#yield = comm:cc1plus

# 낮춘 뒤의 우선순위값 (1 ~ 19, 클수록 양보). 기본 15.
nice_target = 15

# ── 절대 건드리지 않을 프로그램 (기본 보호 목록에 더해서) ─────────
# 기본으로 systemd, sshd, Xorg, gnome-shell, pipewire 등은 이미 보호됩니다.
#protect = comm:obs
#protect = /opt/game/game.bin

# ── 압박 판단 기준 (0 ~ 100) ───────────────────────────────────────
# 들어가는 기준(enter)이 나가는 기준(leave)보다 커야 흔들리지 않습니다.
# confirm 번 연속으로 넘어야 상태가 바뀝니다.
cpu_enter = 80
cpu_leave = 60
mem_enter = 55
mem_leave = 35
critical_enter = 80
critical_leave = 60
confirm = 3

# ── 오래 안 쓴 큰 앱의 메모리 정리 (선택 기능, 기본 꺼짐) ───────────
# 메모리가 위험할 때, 한동안 가만히 있던 큰 앱의 쓰지 않는 메모리를 커널에 돌려달라고 요청합니다.
# 앞에 있는 창을 알 수 있어야(X11) 동작하고, 스왑/zram 이 있어야 효과가 있습니다.
trim_idle = false
idle_secs = 1800
trim_min_rss_mib = 200
trim_min_uid = 1000
trim_cooldown_secs = 600

# ── 앞에 있는 창을 알아내기 (X11) ─────────────────────────────────
# 시스템 서비스로 돌릴 때는 어느 화면을 볼지 알려줘야 합니다. 예:
#x_display = :0
#x_authority = /home/내이름/.Xauthority

# 저널(되돌리기 기록) 폴더. 기본: /var/lib/ramflow
#state_dir = /var/lib/ramflow
