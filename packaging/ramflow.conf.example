# RamFlow 설정 파일 — /etc/ramflow/ramflow.conf
# '#' 로 시작하는 줄은 설명입니다. 같은 항목(yield, protect)은 여러 줄 쓸 수 있습니다.

# 예행연습. true 이면 무엇을 할지 로그로만 알려주고 아무것도 바꾸지 않습니다.
# 로그를 며칠 지켜본 뒤 false 로 바꾸세요. (또는 실행할 때 --apply)
dry_run = true

# 몇 밀리초마다 확인할지 (200 ~ 60000). 한가할 때는 거의 일을 하지 않습니다.
interval_ms = 2000

# ── 누구를 늦출 것인가 ───────────────────────────────────────────
# RamFlow 는 "앞에 있는 프로그램이 CPU 차례를 기다리는" 일이 실제로 생길 때만 움직입니다.
# 그때 아래 둘 중 하나(또는 둘 다)에 해당하는 프로그램의 우선순위를 낮춥니다.
#
# 1) 직접 적기 — 여기에 적은 작업은 언제든 양보해도 되는 것으로 봅니다.
# 형식 1) 실행 파일 전체 경로  : 같은 이름의 다른 프로그램과 헷갈리지 않아 가장 안전합니다.
# 형식 2) comm:이름           : 커널이 보는 프로그램 이름(15글자까지)
#yield = /usr/bin/ffmpeg
#yield = /usr/bin/make
#yield = comm:cc1plus
#
# 2) 자동 — 목록에 없어도, 코어를 오래 독차지하는 프로그램을 스스로 찾습니다.
# 앞에 있는 창을 알 수 있어야 동작합니다. 기본 꺼짐.
auto = false
# 코어 하나의 몇 퍼센트 이상을 (100 = 코어 하나 전부) …
auto_hog_cpu = 35
# 컴퓨터 전체가 꽉 차 있을 때(90% 이상)는 여럿이 코어를 나눠 쓰므로 더 낮은 기준을 씁니다.
auto_hog_cpu_busy = 15
# … 몇 초 동안 계속 쓰면 독차지로 봅니다.
auto_hog_secs = 5
# 이 번호보다 작은 사용자(시스템 계정)의 프로그램은 자동 대상에서 제외합니다.
auto_min_uid = 1000

# 가장 센 단계에서 낮추는 우선순위값 (1 ~ 19, 클수록 양보). 단계는 5 → 10 → 15 → 19 순이고
# 이 값보다 세게는 내려가지 않습니다.
nice_target = 19

# 다른 로그인 세션에 있는 작업은 프로세스 하나가 아니라 세션 전체를 낮춥니다.
# (요즘 데스크톱 커널은 세션마다 CPU 를 똑같이 나눠서, 하나만 낮추면 거의 효과가 없습니다.)
# 보호 대상이 같은 세션에 있으면 세션 전체는 낮추지 않습니다.
use_autogroup = true

# ── 절대 건드리지 않을 프로그램 (기본 보호 목록에 더해서) ─────────
# 기본으로 systemd, sshd, Xorg, gnome-shell, pipewire 등은 이미 보호됩니다.
#protect = comm:obs
#protect = /opt/game/game.bin

# ── 개입 기준 (0 ~ 100, 퍼센트) ───────────────────────────────────
# 앞에 있는 프로그램이 CPU 를 쓰려던 시간 중 기다린 비율입니다.
# 값을 검사하기 전에, 시스템 전체 CPU 정체율이 stall_gate 를 넘을 때만 자세히 봅니다 (한가할 때 아무것도 안 읽기 위해).
stall_gate = 10
# 이 비율을 넘으면 양보를 시작합니다 …
demand_enter = 20
# … 이 비율을 넘은 채 계속되면 한 단계 더 세게 …
demand_high = 35
# … 이 비율 아래로 내려오면 한 단계 풀어줍니다. (low 와 high 사이는 그대로 유지)
demand_low = 10
# 앞에 있는 프로그램이 이 값(%)보다 조용한 채로 release_secs 초가 지나면 전부 되돌립니다.
release_below = 5
release_secs = 10
# 가장 센 단계에서도 기다림이 줄지 않으면 전부 되돌리고 알립니다.
effect_check = true
# 그렇게 되돌린 뒤 다시 시도하기까지 쉬는 시간(초)
retry_after_secs = 120
# 상태가 바뀌려면 연속으로 몇 번 확인되어야 하는지
confirm = 3

# 메모리가 위험한 정도 (0 ~ 100). 위험 상태는 아래 메모리 정리 기능에만 쓰입니다.
critical_enter = 80
critical_leave = 60

# ── 오래 안 쓴 큰 앱의 메모리 정리 (선택 기능, 기본 꺼짐) ───────────
# 메모리가 위험할 때, 한동안 가만히 있던 큰 앱의 쓰지 않는 메모리를 커널에 돌려달라고 요청합니다.
# 앞에 있는 창을 알 수 있어야(X11) 동작하고, 스왑/zram 이 있어야 효과가 있습니다.
trim_idle = false
idle_secs = 1800
trim_min_rss_mib = 200
trim_min_uid = 1000
trim_cooldown_secs = 600

# ── 앞에 있는 창을 알아내기 ───────────────────────────────────────
# X11 은 자동입니다. 시스템 서비스로 돌릴 때는 어느 화면을 볼지 알려줘야 합니다. 예:
#x_display = :0
#x_authority = /home/내이름/.Xauthority
# 웨일랜드 등: 앞 창의 pid 를 (첫 줄에) 출력하는 명령. 1초 안에 끝나야 합니다. 예:
#foreground_cmd = hyprctl activewindow -j | jq .pid
#foreground_cmd = swaymsg -t get_tree | jq '.. | select(.focused?) | .pid'

# 저널(되돌리기 기록) 폴더. 기본: /var/lib/ramflow
#state_dir = /var/lib/ramflow
